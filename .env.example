# Emby server (required)
EMBY_SERVER=http://emby.example:8096

# Auth: API key OR username/password
EMBY_API_KEY=
EMBY_USERNAME=
EMBY_PASSWORD=

# Optional defaults
# EMBY_OUTPUT=./downloads
# EMBY_METHOD=download
# EMBY_PATH_STRIP=/mnt/media
# EMBY_PLAYER=vlc
# EMBY_CACHE_DIR=
# EMBY_NO_AUTH_CACHE=
